# --- Model access: choose ONE option ---
# Option A: Gemini API key (fastest for local dev)
GOOGLE_API_KEY=
# Option B: Vertex AI (use this for Cloud Run / GCP). Leave GOOGLE_API_KEY empty.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Models ---
ORACLE_MODEL=gemini-2.5-flash
ORACLE_CRITIC_MODEL=gemini-2.5-flash

# --- BigQuery (needs ADC: gcloud auth application-default login) ---
BQ_PROJECT=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES=1000000000
BQ_MAX_ROWS=50

# --- Retrieval ---
# tfidf = runs offline with no cloud calls; embeddings = Gemini embeddings
RETRIEVER_BACKEND=tfidf
EMBEDDING_MODEL=gemini-embedding-001
DOCS_DIR=data/docs
INDEX_PATH=data/index/index.json
RETRIEVAL_TOP_K=4

# --- Cost tracking: USD per 1M tokens (copy from the Google Cloud pricing page) ---
PRICE_PER_1M_INPUT=0
PRICE_PER_1M_OUTPUT=0
